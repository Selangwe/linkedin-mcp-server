# --- LinkedIn app credentials (from https://www.linkedin.com/developers/apps) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must exactly match a redirect URL registered on the LinkedIn app's Auth tab.
# This should be https://<your-deployed-host>/oauth/linkedin/callback
LINKEDIN_REDIRECT_URI=https://your-deployed-host.example.com/oauth/linkedin/callback

# --- Where token state is persisted between restarts ---
# "file" = JSON file on disk (Fly.io/Railway/VPS — needs a persistent volume).
# "kv"   = Upstash Redis via @upstash/redis (Vercel — add the Upstash Redis
#          integration from the Storage tab first; it injects the env vars
#          Redis.fromEnv() needs automatically).
TOKEN_STORE_DRIVER=file
# Only used when TOKEN_STORE_DRIVER=file. Must be a path on a persistent
# volume/disk — a path that resets on every deploy/restart will force you to
# re-auth constantly.
TOKEN_STORE_PATH=./data/tokens.json

# --- Optional: token refresh tuning ---
# How long before real expiry the access token is treated as expired and
# refreshed. Must be longer than your longest single run, or a token can go
# stale mid-run (linkedin_post_carousel chains a download, an upload and a
# publish). Default 600 (10 minutes).
# LINKEDIN_TOKEN_REFRESH_BUFFER_SECONDS=600
#
# How many days before the hard re-authorization deadline successful tool
# results start carrying a warning. Default 14.
# LINKEDIN_AUTH_WARN_DAYS=14

# --- Protects the /mcp endpoint and the /oauth/linkedin/start endpoint ---
# Pick any long random string. Also doubles as the consent-gate password on
# this server's own connector-facing OAuth /authorize page (see README §4) —
# whoever completes that page must know this value.
# Usable directly as a static bearer token too:
#   Authorization: Bearer <MCP_AUTH_TOKEN>
MCP_AUTH_TOKEN=

# --- Optional: force the base URL used in OAuth metadata (issuer, endpoint
# URLs, resource identifier). Only needed if X-Forwarded-Proto/Host aren't
# set correctly by whatever's in front of this server; auto-detected from
# the incoming request otherwise.
# PUBLIC_BASE_URL=https://your-deployed-host.example.com

# --- Safety rails (all optional; the defaults suit a main LinkedIn account) ---
# Emergency stop. When set, every outward action refuses and the switch CANNOT
# be cleared from a tool — unset this and redeploy to resume.
# LINKEDIN_KILL_SWITCH=1
#
# Daily caps per action, and across all of them. Deliberately low: the risk
# being managed is the account looking automated, not a slow job.
# LINKEDIN_CAP_MESSAGE_SEND=15
# LINKEDIN_CAP_COMMENT_REPLY=20
# LINKEDIN_CAP_CONNECT_INVITE=15
# LINKEDIN_CAP_POST_PUBLISH=3
# LINKEDIN_CAP_TOTAL=40
#
# Minimum seconds between paced actions (sends, replies, invites). The tool
# refuses and reports when to retry rather than sleeping.
# LINKEDIN_MIN_ACTION_GAP_SECONDS=90
#
# Set to "false" to skip the confirm step for PUBLISHING only. Sends, replies
# and invites always require confirmation and this does not affect them.
# LINKEDIN_REQUIRE_CONFIRMATION=true
#
# Ceiling on total LinkedIn requests per day (LinkedIn publishes no per-endpoint
# limits). Warns at 80%.
# LINKEDIN_DAILY_REQUEST_CEILING=400

# --- Extra OAuth scopes ---
# LINKEDIN_SCOPES in src/constants.ts holds only what a self-serve app can get.
# LinkedIn's /authorization endpoint rejects the entire request if it names a
# scope the app is not approved for, so anything extra goes here, and only once
# approval actually exists (e.g. r_member_postAnalytics after Community
# Management API approval).
# LINKEDIN_EXTRA_SCOPES=r_member_postAnalytics

# --- Unofficial provider (OFF by default) ---
# LinkedIn offers no self-serve route to sending DMs or searching people. This
# forwards those capabilities to an endpoint YOU run. Reaching LinkedIn by
# unofficial means breaks its User Agreement and can get the account
# restricted, so BOTH variables are required — a copied .env cannot switch it
# on by accident.
# LINKEDIN_UNOFFICIAL_PROVIDER=http
# LINKEDIN_UNOFFICIAL_ACK=i-accept-tos-risk
# LINKEDIN_PROVIDER_URL=https://your-own-service.example.com
# LINKEDIN_PROVIDER_SECRET=<shared secret; requests are HMAC-signed>
# LINKEDIN_PROVIDER_CAPABILITIES=message.send

# --- Server ---
PORT=3000
TRANSPORT=http
